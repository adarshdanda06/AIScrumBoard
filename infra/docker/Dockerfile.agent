FROM node:22-slim

# Install minimal dependencies for agent execution
RUN apt-get update && apt-get install -y \
    git \
    curl \
    python3 \
    python3-pip \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for security
RUN groupadd -r agent && useradd -r -g agent -m -d /home/agent agent

# Install Claude Code CLI globally
RUN npm install -g @anthropic-ai/claude-code@latest

WORKDIR /workspace

# Set ownership
RUN chown -R agent:agent /workspace /home/agent

USER agent

# Disable telemetry
ENV CLAUDE_CODE_DISABLE_TELEMETRY=1
ENV HOME=/home/agent
ENV GIT_AUTHOR_NAME="AI Agent"
ENV GIT_AUTHOR_EMAIL="agent@aiscrumboard.local"
ENV GIT_COMMITTER_NAME="AI Agent"
ENV GIT_COMMITTER_EMAIL="agent@aiscrumboard.local"

CMD ["node", "--version"]

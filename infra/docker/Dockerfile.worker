FROM node:22-slim AS base
RUN npm install -g pnpm@10
WORKDIR /app

FROM base AS deps
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY packages/db/package.json ./packages/db/
COPY packages/shared/package.json ./packages/shared/
COPY packages/agent-worker/package.json ./packages/agent-worker/
RUN pnpm install --frozen-lockfile

FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN pnpm --filter @aiscrumboard/agent-worker build

FROM node:22-slim AS runner
# Install Docker CLI for container management
RUN apt-get update && apt-get install -y docker.io && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@10
WORKDIR /app
COPY --from=build /app/packages/agent-worker/dist ./packages/agent-worker/dist
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/db ./packages/db
COPY --from=build /app/packages/shared ./packages/shared
ENV NODE_ENV=production
CMD ["node", "packages/agent-worker/dist/index.js"]

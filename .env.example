# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aiscrumboard:aiscrumboard@localhost:5432/aiscrumboard

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth App (create at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── Anthropic ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Encryption ──────────────────────────────────────────────────────────────
# 32 bytes hex-encoded (openssl rand -hex 32)
ENCRYPTION_KEY=change-me-to-64-hex-chars-0000000000000000000000000000000000

# ─── Agent Worker ────────────────────────────────────────────────────────────
# Max concurrent Claude Code sessions across all projects
MAX_GLOBAL_CONCURRENT_AGENTS=10
# Default per-project concurrency cap
DEFAULT_MAX_AGENTS_PER_PROJECT=3
# Credit threshold in USD — pause all agents below this
LOW_CREDIT_THRESHOLD_USD=5.00
# Credit polling interval (seconds)
CREDIT_POLL_INTERVAL_SECONDS=60

# ─── App URLs ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── GitHub (for agent git operations) ───────────────────────────────────────
# Personal access token or App installation token with repo scope
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# OR use a PAT:
# GITHUB_PAT=
